// Prisma schema for Invoice Management and Budget Tracker
// Database: PostgreSQL (Supabase or Neon)

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum InvoiceStatus {
  draft
  sent
  paid
  overdue
  cancelled
}

enum BudgetPeriod {
  monthly
  quarterly
  yearly
  custom
}

enum PaymentMethod {
  credit_card
  bank_transfer
  cheque
  cash
}

// Keep BudgetPeriod as String for now to avoid breaking existing data — will migrate to enum later with proper USING
// enum BudgetPeriod { monthly quarterly yearly custom }

// User model for authentication
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  password      String?   // for credentials provider
  image         String?
  aiKeyEncrypted String?  @db.Text // per-user BYOK encrypted with BCRYPT_PEPPER
  aiProvider   String?   // nvidia | openai | claude | gemini
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  invoices  Invoice[]
  budgets   Budget[]
  expenses  Expense[]
  clients   Client[]
  auditLogs AuditLog[]
  memberships Membership[]
  invitationsSent Invitation[] @relation("InvitedBy")
  
  // Auth.js relations
  accounts      Account[]
  sessions      Session[]
}

// Auth.js Models - Required for authentication
model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String?  @db.Text
  access_token       String?  @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String?  @db.Text
  session_state      String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Client directory (P1)
model Client {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  address   String?  @db.Text
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  invoices  Invoice[]

  @@index([userId])
  @@index([name])
  @@index([userId, email])
}

// Invoice model
model Invoice {
  id          String   @id @default(cuid())
  invoiceNo   String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId       String?
  org         Org?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  
  clientId    String?
  client      Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  clientName  String
  clientEmail String?
  clientPhone String?
  
  amount      Decimal  @db.Decimal(12,2)
  currency    String   @default("USD")
  status      InvoiceStatus @default(draft)
  
  issueDate   DateTime
  dueDate     DateTime
  paidDate    DateTime?
  sentAt      DateTime?
  recurringRule String? // e.g., monthly
  nextDueDate DateTime?
  
  description String?  @db.Text
  notes       String?  @db.Text
  
  items       InvoiceItem[]
  payments    Payment[]
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@unique([userId, invoiceNo])
  @@index([userId])
  @@index([status])
  @@index([dueDate])
  @@index([userId, status])
  @@index([deletedAt])
  @@index([orgId])
}

// Invoice item (line items)
model InvoiceItem {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  description String
  quantity    Decimal  @db.Decimal(12,2) @default(1)
  rate        Decimal  @db.Decimal(12,2)
  amount      Decimal  @db.Decimal(12,2)
  
  @@index([invoiceId])
}

// Payment model
model Payment {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  
  amount    Decimal  @db.Decimal(12,2)
  method    String // was PaymentMethod enum — kept String to avoid breaking
  paidDate  DateTime
  reference String?
  notes     String?  @db.Text
  
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

// Budget model for budget tracking
model Budget {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String?
  org       Org?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  
  name      String
  limit     Decimal  @db.Decimal(12,2)
  spent     Decimal  @db.Decimal(12,2) @default(0)
  remaining Decimal  @db.Decimal(12,2)
  period    String // was BudgetPeriod enum — kept String to avoid breaking existing data
  
  startDate DateTime
  endDate   DateTime
  
  category  String? // optional category (e.g., marketing, operations)
  color     String? // hex color for UI
  
  isActive  Boolean @default(true)
  
  expenses  Expense[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([period])
  @@index([userId, startDate])
  @@index([deletedAt])
  @@index([orgId])
  @@index([userId, name])
}

// Expense model for budget tracking
model Expense {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orgId     String?
  org       Org?     @relation(fields: [orgId], references: [id], onDelete: SetNull)
  
  budgetId  String?
  budget    Budget?  @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  
  description String
  amount    Decimal  @db.Decimal(12,2)
  category  String
  date      DateTime
  
  notes     String?  @db.Text
  receipt   String? // file path or URL
  receiptMime String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  @@index([userId])
  @@index([budgetId])
  @@index([date])
  @@index([userId, date])
  @@index([deletedAt])
  @@index([orgId])
}

// Audit trail (P2)
model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String
  entity    String
  entityId  String
  diff      Json?
  ip        String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([entity, entityId])
}

// Team workspaces (P2 backlog) — scaffold for multi-tenant
model Org {
  id        String   @id @default(cuid())
  name      String
  slug      String?  @unique
  createdAt DateTime @default(now())
  members   Membership[]
  invitations Invitation[]
  invoices  Invoice[]
  budgets   Budget[]
  expenses  Expense[]

  @@index([name])
  @@index([slug])
}

model Invitation {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email     String
  role      String   @default("member")
  token     String   @unique
  invitedBy String
  inviter   User     @relation("InvitedBy", fields: [invitedBy], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([orgId, email])
  @@index([token])
  @@index([orgId])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String
  orgId     String
  role      String   @default("member") // owner, member
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, orgId])
  @@index([orgId])
}
