# ==========================================
# DATABASE CONFIGURATION (REQUIRED)
# ==========================================
# PostgreSQL connection string
# Use Supabase or Neon for production

# Supabase: Get from Project Settings → Database → Connection Pooling
# DATABASE_URL="postgresql://postgres:password@db.XXXX.supabase.co:6543/postgres?schema=public"

# Neon: Get from Connection String
# DATABASE_URL="postgresql://user:password@ep-XXXX.us-east-1.neon.tech/database?schema=public"

# Local development (change credentials as needed)
DATABASE_URL="postgresql://user:password@localhost:5432/invoice_app"

# ==========================================
# NEXTAUTH CONFIGURATION (REQUIRED)
# ==========================================
# NextAuth secret (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
# MUST be at least 32 characters for production
NEXTAUTH_SECRET="change-this-to-a-random-secret-in-production-min-32-chars"

# NextAuth URL - your application URL
# Local: http://localhost:3000
# Production: https://yourdomain.vercel.app
NEXTAUTH_URL="http://localhost:3000"

# ==========================================
# GITHUB OAUTH (OPTIONAL)
# ==========================================
# Setup: https://github.com/settings/developers
# Create New OAuth App with callback: http://localhost:3000/api/auth/callback/github
# NOTE: Code uses GITHUB_ID / GITHUB_SECRET (Auth.js also accepts AUTH_GITHUB_ID). Keep both in sync.
GITHUB_ID="your-github-oauth-id"
GITHUB_SECRET="your-github-oauth-secret"
# AUTH_GITHUB_ID="your-github-oauth-id"
# AUTH_GITHUB_SECRET="your-github-oauth-secret"

# ==========================================
# GOOGLE OAUTH (OPTIONAL)
# ==========================================
# Setup: https://console.cloud.google.com/
# Create OAuth 2.0 Client IDs (Web application)
# Add authorized redirects:
#   Local: http://localhost:3000/api/auth/callback/google
#   Production: https://invoice-app-omega-ten.vercel.app/api/auth/callback/google
# NOTE: Code uses GOOGLE_ID / GOOGLE_SECRET (Auth.js also accepts AUTH_GOOGLE_ID). Keep both in sync.
GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_SECRET="your-google-client-secret"
# AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="your-google-client-secret"

# ==========================================
# PUBLIC API CONFIGURATION (OPTIONAL)
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:3000"

# ==========================================
# INSTRUCTIONS FOR VERCEL DEPLOYMENT
# ==========================================
# 1. Copy these variable names to Vercel Dashboard → Settings → Environment Variables
# 2. Fill in actual values for database and OAuth providers
# 3. Generate NEXTAUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 4. Set NEXTAUTH_URL to your Vercel deployment URL (e.g., https://invoice-app.vercel.app)
# 5. Update OAuth provider callback URLs in GitHub/Google settings to match Vercel URL
#
# For Vercel: Set these exactly as shown (variable names are case-sensitive)
# - DATABASE_URL
# - NEXTAUTH_SECRET  
# - NEXTAUTH_URL  (Production: https://invoice-app-omega-ten.vercel.app)
# - NEXT_PUBLIC_API_URL (Production: https://invoice-app-omega-ten.vercel.app)
# - GOOGLE_ID (or AUTH_GOOGLE_ID) (optional)
# - GOOGLE_SECRET (or AUTH_GOOGLE_SECRET) (optional)
# - GITHUB_ID (or AUTH_GITHUB_ID) (optional)
# - GITHUB_SECRET (or AUTH_GITHUB_SECRET) (optional)
# - BCRYPT_PEPPER (optional, extra pepper for password hashing)
# - CRON_SECRET (required for /api/crons/* on Vercel Hobby)
# - NEXT_PUBLIC_SENTRY_DSN (optional, for Sentry monitoring)

# ==========================================
# SECURITY (OPTIONAL)
# ==========================================
# Extra pepper for bcrypt (S9) — keep secret, rotate with passwords
# BCRYPT_PEPPER="generate-with: openssl rand -base64 24"

# Cron auth for Vercel Hobby (no built-in cron auth)
# CRON_SECRET="openssl rand -base64 32"

# Sentry DSN for error monitoring (O3)
# NEXT_PUBLIC_SENTRY_DSN="https://...@o...ingest.sentry.io/..."

